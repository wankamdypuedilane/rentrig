# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git: never commit real keys.

# Supabase > Project Settings > API Keys (publishable key, starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public base URL of the app (Stripe redirects customers back to it)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys > Secret keys (starts with sb_secret_).
# RentRig's payment code uses it to record payments (src/lib/payments/store.ts).
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Stripe, TEST MODE ONLY (chapter 18). Dashboard > Developers > API keys, in a
# sandbox or with "Test mode" on. The app refuses live keys (sk_live_...).
# STRIPE_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# in development; shown on the webhook endpoint page in the Dashboard otherwise.
# STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
